{
  "name": "stuntspecula",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/model-a/dev.ps1",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src tests scripts docs *.json *.ts *.mjs *.md",
    "format:check": "prettier --check src tests scripts docs *.json *.ts *.mjs *.md",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check",
    "ai:check": "node scripts/check-ai.mjs",
    "start": "next start",
    "build:vercel": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "esbuild": "^0.27.3"
  },
  "type": "module"
}
