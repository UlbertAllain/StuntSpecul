# Local development. Do not commit .env.local.
APP_ORIGIN=http://localhost:3000

# Local-only SQLite; run npm run db:migrate before npm run dev.
DATABASE_URL=file:./stuntspecula.db
DATABASE_AUTH_TOKEN=

# For Vercel AND the local first-admin setup, use the same remote libSQL database:
# DATABASE_URL=libsql://your-database-your-account.turso.io
# DATABASE_AUTH_TOKEN=your-database-token
# Vercel APP_ORIGIN=https://stuntspecula.vercel.app

# Optional: enables the parent result assistant.
GEMINI_API_KEY=
GEMINI_MODEL=
